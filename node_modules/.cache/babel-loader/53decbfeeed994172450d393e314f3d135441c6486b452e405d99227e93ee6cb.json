{"ast":null,"code":"export default {\n  name: 'MainPage',\n  computed: {\n    imagePath() {\n      return require('@/img/emolere.jpg');\n    },\n    cvPath() {\n      return `${process.env.BASE_URL}EMolere_Resume.pdf`;\n    }\n  },\n  props: {\n    msg: String\n  }\n};","map":{"version":3,"names":["name","computed","imagePath","require","cvPath","process","env","BASE_URL","props","msg","String"],"sources":["/Users/flipflop/Desktop/Bureau3/siteGit/GitWebSite/ehngmolere/src/views/HomeVue.vue"],"sourcesContent":["<template>\n  <main class=\"home-page container\">\n      <section class=\"home-hero\">\n        <div class=\"home-intro\">\n          <p class=\"home-eyebrow\">CI/CD Automation · Infrastructure · Reliability</p>\n          <h1>Emeric Molère</h1>\n          <h2>DevOps Engineer</h2>\n          <p class=\"home-description\">I build reliable CI/CD workflows, automate infrastructure and improve developer productivity.</p>\n          <p class=\"home-specialties\"><strong>Main focus:</strong> Azure DevOps · Python · Ansible · CI/CD</p>\n          <p class=\"home-background\">I earned a Master's degree in Software Development at Toulouse University in 2023. After discovering DevOps during my apprenticeship at Capgemini, I joined Ansys to deepen my expertise in automation, observability and reliable delivery.</p>\n          <p class=\"home-availability\"><i class=\"fa-solid fa-circle\" aria-hidden=\"true\"></i> Open to DevOps, SRE and platform engineering opportunities.</p>\n          <div class=\"home-actions\">\n            <a class=\"btn btn-outline-secondary\" href=\"mailto:emeric.molere@master-developpement-logiciel.com\"><i class=\"fa-regular fa-envelope\" aria-hidden=\"true\"></i> Contact</a>\n            <a class=\"btn btn-outline-secondary\" :href=\"cvPath\" download=\"Emeric-Molere-CV.pdf\"><i class=\"fa-solid fa-file-arrow-down\" aria-hidden=\"true\"></i> Download CV</a>\n          </div>\n        </div>\n        <div class=\"home-profile\">\n          <img :src=\"imagePath\" alt=\"Portrait of Emeric Molère\" class=\"home-image\">\n          <div class=\"home-profile-caption\">\n            <i class=\"fa-solid fa-location-dot\" aria-hidden=\"true\"></i>\n            Toulon, France · Remote\n          </div>\n        </div>\n      </section>\n\n      <section class=\"home-focus\" aria-label=\"Areas of focus\">\n        <article>\n          <i class=\"fa-solid fa-gears\" aria-hidden=\"true\"></i>\n          <h3>Automation</h3>\n          <p>Reusable pipelines and tools that reduce repetitive work.</p>\n        </article>\n        <article>\n          <i class=\"fa-solid fa-server\" aria-hidden=\"true\"></i>\n          <h3>Infrastructure</h3>\n          <p>Consistent environments across Windows and Linux systems.</p>\n        </article>\n        <article>\n          <i class=\"fa-solid fa-chart-line\" aria-hidden=\"true\"></i>\n          <h3>Reliability</h3>\n          <p>Observability and operational practices for dependable services.</p>\n        </article>\n      </section>\n  </main>\n</template>\n\n<script>\nexport default {\n  name: 'MainPage',\n  computed: {\n    imagePath() {\n      return require('@/img/emolere.jpg');\n    },\n    cvPath() {\n      return `${process.env.BASE_URL}EMolere_Resume.pdf`;\n    }\n  },\n  props: {\n    msg: String\n  }\n}\n</script>\n\n<style scoped>\n.home-page {\n  max-width: 1080px;\n  padding-bottom: 3rem;\n  padding-top: 2.5rem;\n}\n\n.home-hero {\n  align-items: center;\n  display: grid;\n  gap: 4rem;\n  grid-template-columns: minmax(0, 1.35fr) minmax(240px, 0.65fr);\n  min-height: 470px;\n}\n\n.home-eyebrow {\n  color: #526579;\n  font-size: 0.8rem;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  margin-bottom: 1rem;\n  text-transform: uppercase;\n}\n\n.home-intro h1 {\n  color: #123b5d;\n  font-size: clamp(2.5rem, 6vw, 4.5rem);\n  line-height: 1;\n  margin-bottom: 0.75rem;\n}\n\n.home-intro h2 {\n  font-size: 1.5rem;\n  font-weight: 400;\n  margin-bottom: 1.5rem;\n}\n\n.home-description {\n  font-size: 1.3rem;\n  line-height: 1.5;\n  max-width: 620px;\n}\n\n.home-specialties {\n  color: #123b5d;\n  font-size: 0.95rem;\n  margin-bottom: 1.25rem;\n}\n\n.home-availability {\n  color: #526579;\n  font-size: 0.9rem;\n  margin-top: 1.25rem;\n}\n\n.home-availability i {\n  color: #198754;\n  font-size: 0.55rem;\n  margin-right: 0.4rem;\n  vertical-align: middle;\n}\n\n.home-background {\n  color: #526579;\n  line-height: 1.7;\n  max-width: 680px;\n}\n\n.home-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.75rem;\n  margin-top: 1.75rem;\n}\n\n.home-actions i {\n  margin-right: 0.4rem;\n}\n\n.home-profile {\n  text-align: center;\n}\n\n.home-image {\n  border: 10px solid #e8f0f5;\n  border-radius: 50%;\n  height: 240px;\n  object-fit: cover;\n  width: 240px;\n}\n\n.home-profile-caption {\n  color: #526579;\n  margin-top: 1rem;\n}\n\n.home-profile-caption i {\n  color: #123b5d;\n  margin-right: 0.35rem;\n}\n\n.home-focus {\n  border-top: 1px solid #d8e3eb;\n  display: grid;\n  gap: 1.5rem;\n  grid-template-columns: repeat(3, 1fr);\n  padding-top: 2rem;\n}\n\n.home-focus article {\n  padding: 0.5rem;\n}\n\n.home-focus i {\n  color: #123b5d;\n  font-size: 1.4rem;\n  margin-bottom: 0.75rem;\n}\n\n.home-focus h3 {\n  font-size: 1.1rem;\n}\n\n.home-focus p {\n  color: #526579;\n  line-height: 1.5;\n  margin-bottom: 0;\n}\n\n@media (max-width: 768px) {\n  .home-page {\n    padding-top: 1.5rem;\n  }\n\n  .home-hero {\n    gap: 2rem;\n    grid-template-columns: 1fr;\n    text-align: center;\n  }\n\n  .home-actions {\n    justify-content: center;\n  }\n\n  .home-profile {\n    grid-row: 1;\n  }\n\n  .home-focus {\n    grid-template-columns: 1fr;\n    text-align: center;\n  }\n}\n</style>\n\n"],"mappings":"AA8CA,eAAe;EACbA,IAAI,EAAE,UAAU;EAChBC,QAAQ,EAAE;IACRC,SAASA,CAAA,EAAG;MACV,OAAOC,OAAO,CAAC,mBAAmB,CAAC;IACrC,CAAC;IACDC,MAAMA,CAAA,EAAG;MACP,OAAQ,GAAEC,OAAO,CAACC,GAAG,CAACC,QAAS,oBAAmB;IACpD;EACF,CAAC;EACDC,KAAK,EAAE;IACLC,GAAG,EAAEC;EACP;AACF"},"metadata":{},"sourceType":"module","externalDependencies":[]}