{"ast":null,"code":"export default {\n  methods: {\n    handleLogoError(event) {\n      event.target.style.display = 'none';\n      event.target.nextElementSibling.classList.add('company-logo-fallback-visible');\n    }\n  }\n};","map":{"version":3,"names":["methods","handleLogoError","event","target","style","display","nextElementSibling","classList","add"],"sources":["/Users/flipflop/Desktop/Bureau3/siteGit/GitWebSite/ehngmolere/src/views/ProfessionalExperiences.vue"],"sourcesContent":["<template>\n  <div class=\"container col-md-8 align-items-center\">\n      <h1 class=\"text-center my-4\">Experiences</h1>\n\n      <section class=\"mb-5\">\n        <img class=\"company-logo\" loading=\"lazy\" src=\"https://media.licdn.com/dms/image/v2/D4E0BAQGkaE0mS-7vWg/company-logo_100_100/B4EZgYjvqKHgAc-/0/1752758680540/ansys_inc_logo?e=1791417600&amp;v=beta&amp;t=TC3ybN59TQsigFt1zkVp_Sndd-m5NnfkHl7a3CH8lK4\" alt=\"Ansys logo\" @error=\"handleLogoError\">\n        <span class=\"company-logo-fallback\" aria-hidden=\"true\">AN</span>\n        <h2>DevOps Engineer</h2>\n        <h4>Ansys · Part of Synopsys · Permanent contract</h4>\n        <p class=\"text-muted\">Jan. 2024 - Present · Toulon, France · Remote</p>\n        <ul>\n          <li>Managed and supervised Windows and Linux virtual and physical machines used as ADO agents, using Ansible playbooks to ensure configuration consistency.</li>\n          <li>Centralized pipeline code from multiple repositories into a new <strong>ProjectTools</strong> repository, with Python utilities to access ADO, JFrog Artifactory, Prometheus and Thanos.</li>\n          <li>Created reusable DevOps templates to centralize common pipeline code, including <code>run-python-venv.yml</code> and <code>sonarq-analysis.yml</code>.</li>\n          <li>Implemented an automated build artifact cleanup system that removes artifacts older than 10 days and artifacts associated with completed pull requests.</li>\n          <li>Migrated Bamboo pipelines to Azure DevOps.</li>\n        </ul>\n      </section>\n\n      <section class=\"mb-5\">\n        <img class=\"company-logo\" loading=\"lazy\" src=\"https://media.licdn.com/dms/image/v2/D4E0BAQHIL3HctxNfvg/company-logo_100_100/B4EZokv7VQIUAQ-/0/1761553135376/capgemini_logo?e=1791417600&amp;v=beta&amp;t=Sx1MiaRtropV50XeJDFnteWWGn5Jkk0dOF1LnHwvMZU\" alt=\"Capgemini logo\" @error=\"handleLogoError\">\n        <span class=\"company-logo-fallback\" aria-hidden=\"true\">CG</span>\n        <h2>Site Reliability Engineer</h2>\n        <h4>Capgemini · Work-study contract</h4>\n        <p class=\"text-muted\">Dec. 2021 - Jun. 2023 · Toulouse, France · Hybrid</p>\n        <ul>\n          <li>Maintained a microservices platform in operational condition using Prometheus, Grafana, Elasticsearch and Kibana.</li>\n          <li>Automated alerts and operational processes with Alertmanager, Ansible, Groovy, Jenkins and Oracle Database.</li>\n          <li>Built a proof of concept to automate data exports from the production schema to the validation environment.</li>\n          <li>Presented project progress to the client.</li>\n        </ul>\n      </section>\n\n      <section class=\"mb-5\">\n        <img class=\"company-logo\" loading=\"lazy\" src=\"https://media.licdn.com/dms/image/v2/D4D0BAQFWx2NarV3c-g/company-logo_100_100/B4DZbEP28lG0AQ-/0/1747049214225/universite_paul_sabatier_toulouse_iii_logo?e=1791417600&amp;v=beta&amp;t=89-y-kERl0ff8M4c_k7BeCvitDQwRqHw_gyDSscewzM\" alt=\"Toulouse University logo\" @error=\"handleLogoError\">\n        <span class=\"company-logo-fallback\" aria-hidden=\"true\">TU</span>\n        <h2>Tutor</h2>\n        <h4>Toulouse University · Fixed-term contract</h4>\n        <p class=\"text-muted\">Oct. 2021 - Dec. 2021 · Toulouse, France</p>\n        <p>Teaching computer science, discrete mathematics and digital science.</p>\n      </section>\n\n      <section class=\"mb-5\">\n        <img class=\"company-logo\" loading=\"lazy\" src=\"https://media.licdn.com/dms/image/v2/C4E0BAQGXZPFarym18w/company-logo_100_100/company-logo_100_100/0/1642678074294/universite_de_bordeaux_logo?e=1791417600&amp;v=beta&amp;t=IztpApkFee0Bvv4Yh-oJCeYpSRCwusTh9xpXNH2ZOZg\" alt=\"Bordeaux University logo\" @error=\"handleLogoError\">\n        <span class=\"company-logo-fallback\" aria-hidden=\"true\">UB</span>\n        <h2>Tutor</h2>\n        <h4>University of Bordeaux · Fixed-term contract</h4>\n        <p class=\"text-muted\">Sep. 2020 - Dec. 2020 · Bordeaux, France</p>\n        <p>Teaching Python.</p>\n      </section>\n  </div>\n</template>\n\n<script>\nexport default {\n  methods: {\n    handleLogoError(event) {\n      event.target.style.display = 'none';\n      event.target.nextElementSibling.classList.add('company-logo-fallback-visible');\n    }\n  }\n}\n</script>\n"],"mappings":"AAsDA,eAAe;EACbA,OAAO,EAAE;IACPC,eAAeA,CAACC,KAAK,EAAE;MACrBA,KAAK,CAACC,MAAM,CAACC,KAAK,CAACC,OAAM,GAAI,MAAM;MACnCH,KAAK,CAACC,MAAM,CAACG,kBAAkB,CAACC,SAAS,CAACC,GAAG,CAAC,+BAA+B,CAAC;IAChF;EACF;AACF"},"metadata":{},"sourceType":"module","externalDependencies":[]}